rules_version = '2';

// Toutes les données transitent par l'API Cloud Functions (Admin SDK, qui
// ignore ces règles). Le client web n'utilise jamais le SDK Firestore
// directement : on ferme donc l'accès direct par défaut.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
