# Secrets serveur uniquement — jamais exposés au navigateur.
# En local (émulateur) : copier vers functions/.env
# En production : firebase functions:secrets:set GEMINI_API_KEY (idem pour les deux autres)
GEMINI_API_KEY=your_gemini_api_key_here
PLATE_RECOGNIZER_TOKEN=your_platerecognizer_token_here
SIV_API_KEY=your_rapidapi_siv_key_here
