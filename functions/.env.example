# Server-side secrets only — never exposed to the browser.
# Local (emulator): copy to functions/.env
# Production (Firebase Cloud Functions): firebase functions:secrets:set GEMINI_API_KEY (same for the other two)
# Production (Vercel): set as plain env vars in the Vercel project settings
GEMINI_API_KEY=your_gemini_api_key_here
PLATE_RECOGNIZER_TOKEN=your_platerecognizer_token_here
SIV_API_KEY=your_rapidapi_siv_key_here
