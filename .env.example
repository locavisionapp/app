# Configuration Firebase publique (identité uniquement — sans risque si exposée
# côté navigateur). Toutes les données passent par l'API Cloud Functions.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optionnel : URL de base de l'API si elle n'est pas servie sur le même domaine
# que le front (sinon les appels passent par /v1 sur le même domaine).
# VITE_API_BASE_URL=https://api.locavision.app

# Mettre à "true" en local pour utiliser les émulateurs Firebase (npm run functions:serve)
# et les comptes de test créés par functions/scripts/seed.js. Ne jamais activer en prod.
# VITE_USE_FIREBASE_EMULATOR=true
