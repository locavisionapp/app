# Public Firebase config (identity only — safe to expose in the browser).
# All data flows through the API, never a client-side key.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: API base URL if it isn't served on the same domain as the
# frontend (otherwise calls go through /v1 on the same domain).
# VITE_API_BASE_URL=https://api.locavision.app

# Set to "true" locally to use the Firebase emulators (npm run functions:serve)
# and the test accounts created by functions/scripts/seed.js. Never enable in prod.
# VITE_USE_FIREBASE_EMULATOR=true
