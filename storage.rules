rules_version = '2';

// Les photos d'inspection sont écrites par Cloud Functions (Admin SDK, qui
// ignore ces règles) et servies en lecture via leur URL publique GCS.
// Le client n'utilise jamais le SDK Storage directement.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
